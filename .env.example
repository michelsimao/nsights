# Copie para .env e ajuste. Todos têm default no docker-compose.yml,
# então o .env é opcional para rodar localmente.

# --- Postgres ---
POSTGRES_USER=riskops
POSTGRES_PASSWORD=riskops
POSTGRES_DB=riskops
POSTGRES_HOST_PORT=5433        # porta no host (5432 costuma estar ocupada)

# --- API ---
APP_ENV=development
# APENAS DESENVOLVIMENTO. Gere um valor próprio: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-change-me
JWT_EXPIRE_MINUTES=480
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=INFO
BACKEND_HOST_PORT=8000

# Usado ao rodar a API fora do Docker (uv run uvicorn ...):
# DATABASE_URL=postgresql+psycopg://riskops:riskops@localhost:5433/riskops

# --- Frontend ---
FRONTEND_HOST_PORT=5173
